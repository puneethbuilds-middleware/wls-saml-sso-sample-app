<%@ page contentType="text/html; charset=UTF-8" %><%@ page import="java.util.Map" %><%! String e(Object v){return v==null?"Not available":v.toString().replace("&","&amp;").replace("<","&lt;").replace(">","&gt;").replace("\"","&quot;");} void section(javax.servlet.jsp.JspWriter o,String title,Map<String,String> data)throws java.io.IOException{o.write("<section class=\"plain-section\"><h2>"+e(title)+"</h2><div class=\"table-wrap\"><table>");for(Map.Entry<String,String>x:data.entrySet())o.write("<tr><th>"+e(x.getKey())+"</th><td><pre>"+e(x.getValue())+"</pre></td></tr>");o.write("</table></div></section>");} %><!doctype html><html lang="en"><head><meta name="viewport" content="width=device-width, initial-scale=1"><title>SSO Test Result</title><style><%@ include file="/WEB-INF/style.css" %>.plain-shell{max-width:880px;margin:36px auto;padding:0 22px 48px}.plain-header{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:0 0 20px;border-bottom:1px solid #dbe3ef}.plain-header h1{margin:0;font-size:26px;color:#1f3f68}.plain-header .eyebrow{color:#54708f}.plain-signout{padding:8px 12px;border:1px solid #b8c8dc;border-radius:5px;background:#fff;color:#28537e;font-size:14px;font-weight:700;text-decoration:none}.plain-state{margin-top:24px;padding:18px 20px;border-left:4px solid #278056;background:#effaf3}.plain-state h2{margin:0 0 5px;font-size:23px;color:#16633e}.plain-state p{margin:0}.plain-principal{margin-top:8px!important;overflow-wrap:anywhere;font:600 14px ui-monospace,SFMono-Regular,Consolas,monospace}.plain-note{margin:18px 0;padding:14px 16px;border-left:4px solid #4a7bb2;background:#f3f7fc;color:#344054}.plain-section{margin-top:20px;padding:20px;border:1px solid #dbe3ef;border-radius:6px;background:#fff}.plain-section h2{margin:0 0 14px;color:#244a73;font-size:19px}@media(max-width:720px){.plain-shell{margin:24px auto;padding:0 16px 34px}.plain-header h1{font-size:23px}table{min-width:620px}}</style></head><body><main class="plain-shell"><header class="plain-header"><div><p class="eyebrow">WebLogic SAML sample</p><h1>SAML SSO Test Application</h1></div><a class="plain-signout" href="../logout">Sign out</a></header><section class="plain-state"><h2>SSO login succeeded</h2><p>WebLogic allowed access to the protected page.</p><p class="plain-principal">Signed in as: <%=e(request.getRemoteUser() == null ? request.getUserPrincipal() : request.getRemoteUser())%></p></section><aside class="plain-note">The details below show what the application received after WebLogic completed SSO.</aside><% section(out,"Authentication and request",(Map)request.getAttribute("ssoFacts")); section(out,"Role checks",(Map)request.getAttribute("ssoRoles")); section(out,"Token and assertion inspection",(Map)request.getAttribute("ssoToken")); section(out,"Request headers",(Map)request.getAttribute("ssoHeaders")); %></main></body></html>
