<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="3.1">
  <display-name>SAML SSO Diagnostics</display-name>
  <!-- Optional: replace with roles configured in your identity store, e.g. employee,admin -->
  <context-param><param-name>diagnostic.roles</param-name><param-value></param-value></context-param>
  <!-- Set this to the external public URL when a proxy/load balancer changes the request host or scheme. -->
  <context-param><param-name>slo.redirect-uri</param-name><param-value></param-value></context-param>
  <servlet><servlet-name>Logout</servlet-name><servlet-class>com.example.ssodiagnostics.LogoutServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>Logout</servlet-name><url-pattern>/logout</url-pattern></servlet-mapping>
  <security-constraint><web-resource-collection><web-resource-name>SSO protected diagnostics</web-resource-name><url-pattern>/restricted/*</url-pattern></web-resource-collection><auth-constraint><role-name>sso-user</role-name></auth-constraint></security-constraint>
  <security-role><role-name>sso-user</role-name></security-role>
  <!-- WebLogic may dispatch authorization denials here; provider-level failures can occur before the WAR is invoked. -->
  <error-page><error-code>403</error-code><location>/error.jsp</location></error-page>
  <error-page><exception-type>java.lang.Throwable</exception-type><location>/error.jsp</location></error-page>
</web-app>
